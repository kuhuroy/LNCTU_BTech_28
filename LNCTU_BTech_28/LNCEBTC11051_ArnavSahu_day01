      class Solution:
    def findMaxAverage(self, nums: List[int], k: int) -> float:
        n = len(nums)
        s=0
        for i in range(k):
            s+=nums[i]

        max_avg = s/k
        for i in range(k,n):
                s+=nums[i]
                s-=nums[i-k]
                avg = s/k
                max_avg=max(max_avg,avg)
        return max_avg


